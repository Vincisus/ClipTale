# Server LM Studio locale (Developer > Start server)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Identificatore esatto del modello in LM Studio (si puo cambiare anche dalla pagina)
LMSTUDIO_MODEL=huihui-qwen3.6-35b-a3b-abliterated-mtp
# off = niente "ragionamento" nascosto: 5-20 volte piu veloce sui modelli Qwen3.x
LMSTUDIO_THINKING=off
# token massimi per risposta (ragionamento incluso)
LMSTUDIO_MAX_TOKENS=12000
# secondi di silenzio del modello prima di considerarlo bloccato
LMSTUDIO_IDLE_TIMEOUT=300
# durata massima di una singola chiamata, in secondi
LMSTUDIO_TOTAL_TIMEOUT=3600
